# 行尾统一由仓库决定，不随各人的 core.autocrlf 漂
* text=auto

# .bat 必须是 CRLF：LF 下 cmd 的 goto 可能找不到标签
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 必须是 LF：CRLF 会让 bash 报 $'\r': command not found
*.sh text eol=lf
start.sh text eol=lf

*.py text
*.js text
*.css text
*.html text
*.md text

# 截图原样，别做任何转换
*.png binary
*.jpg binary
*.zip binary
